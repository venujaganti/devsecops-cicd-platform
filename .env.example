# Application
APP_NAME=DevSecOps CI/CD Platform
APP_ENV=development
DEBUG=false

# PostgreSQL
POSTGRES_DB=devsecops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173
API_BASE_URL=http://localhost:8000

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost

# Security
SECRET_KEY=change-this-development-secret-key-please-replace-in-production

# Agent / Monitoring
AGENT_INTERVAL=30
REQUEST_TIMEOUT=10

# Kubernetes
K8S_NAMESPACE=devsecops

# Jenkins
JENKINS_PORT=8080

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

